        "Supports marking updates as minor edits to avoid notification spam for small changes.",
    )
    async def update_confluence_page(
        space_key: str,
        title: str,
        content: str,
        expected_version: int,
        site_alias: Optional[Union[str, None]] = None,
        minor_edit: bool = False,  # Set to True for small changes like typo fixes or formatting adjustments
    ) -> list[types.TextContent]:
        """Update a Confluence page with version conflict detection.

        Args:
            space_key: The key of the space containing the page
            title: The title of the page to update
            content: New markdown content for the page
            expected_version: The version number we expect the page to be at
            site_alias: Optional site alias for multi-site configurations
            minor_edit: Set to True for small changes (typos, formatting) to avoid notification spam.
                       Set to False for substantial content changes that watchers should know about.
        """
        try:
            logger.debug(
                f"Executing update_confluence_page for '{title}' in space {space_key} with expected version {expected_version}"
            )

            try:
                # Use the service to update the page
                page = await ConfluenceService.update_page_from_markdown(
                    space_key=space_key,
                    title=title,
                    content=content,
                    expected_version=expected_version,
                    site_alias=site_alias,
                    minor_edit=minor_edit,
                )

                # Return success message with new version info
                return [
                    types.TextContent(
                        type="text",
                        text=f"""# Page Updated Successfully

- Title: {title}
- Space: {space_key}
- New Version: {page.get('response', {}).get('version', {}).get('number')}
- Last Updated: {page.get('response', {}).get('version', {}).get('when')}
- URL: {page.get('url')}

The page has been updated successfully.""",
                    )
                ]

            except ValueError as e:
                if "Version mismatch" in str(e):
                    # Get current page info for helpful error message
                    client = PlatformRegistry.get_platform(
                        "confluence", site_alias=site_alias
                    )
                    client.connect()
                    current_page = client.get_page_by_title(space_key, title)

                    return [
                        types.TextContent(
                            type="text",
                            text=f"""# Version Conflict Detected

The page has been modified since you last retrieved it.
- Your version: {expected_version}
- Current version: {current_page.get('version', {}).get('number')}
- Last modified: {current_page.get('version', {}).get('when')}

Please retrieve the latest version and merge your changes.

To help with merging, here are the options:
1. Get the latest version using `get_confluence_page` to see recent changes
2. Modify your changes to incorporate any updates
3. Try the update again with the new version number

Would you like me to fetch the latest version for you?""",
                        )
                    ]
                else:
                    return [types.TextContent(type="text", text=f"# Error\n{str(e)}")]

        except Exception as e:
            logger.error(f"Error in update_confluence_page: {e}", exc_info=True)
            return [
                types.TextContent(
                    type="text", text=f"# Error updating Confluence page\n\n{str(e)}"
                )
            ]

    @mcp_server.tool(
        name="test_store_value",
        description="Test endpoint to store a value in session",
    )
    async def test_store_value(value: str, ctx: Context) -> list[types.TextContent]:
        """Store a test value using session context."""
        try:
            # Enhanced context debugging
            logger.debug("=== Context Debug Info (store_value) ===")
            logger.debug(f"Context type: {type(ctx)}")
            logger.debug(f"Context dir: {dir(ctx)}")
            logger.debug(f"Client ID: {ctx.client_id}")
            logger.debug(f"Session Info: {ctx.session}")
            logger.debug(f"Request ID: {getattr(ctx, 'request_id', 'No request_id')}")
            logger.debug(f"All Context attrs: {vars(ctx)}")
            logger.debug("=====================================")

            # Initialize session store if needed
            if not hasattr(server, "_session_store"):
                server._session_store = {}

            # Generate session ID - use request_id as it's more reliable
            session_id = str(id(ctx.session))
            logger.debug(f"Using session_id: {session_id}")

            # Initialize client data structure if needed
            if session_id not in server._session_store:
                server._session_store[session_id] = {
                    "preferences": {"theme": "light", "language": "en"},
                    "state": {"last_action": None, "recent_values": []},
                    "cache": {"frequently_used": []},
                }

            # Update state
            client_data = server._session_store[session_id]
            client_data["state"]["last_action"] = "store_value"

            # Add to recent values (keep last 5)
            recent = client_data["state"]["recent_values"]
            if value not in recent:
                recent.insert(0, value)
                if len(recent) > 5:
                    recent.pop()

            # Update frequently used
            if value not in client_data["cache"]["frequently_used"]:
                client_data["cache"]["frequently_used"].append(value)

            return [
                types.TextContent(
                    type="text",
                    text=f"Stored value '{value}' for session {session_id}\nRecent values: {recent}\nFrequently used: {client_data['cache']['frequently_used']}",
                )
            ]
        except Exception as e:
            logger.error(f"Error in test_store_value: {e}", exc_info=True)
            raise

    @mcp_server.tool(
        name="test_get_value",
        description="Test endpoint to retrieve the stored value from session",
    )
    async def test_get_value(ctx: Context) -> list[types.TextContent]:
        """Retrieve the test value using session context."""
        try:
            # Enhanced context debugging
            logger.debug("=== Context Debug Info (get_value) ===")
            logger.debug(f"Context type: {type(ctx)}")
            logger.debug(f"Context dir: {dir(ctx)}")
            logger.debug(f"Client ID: {ctx.client_id}")
            logger.debug(f"Session Info: {ctx.session}")
            logger.debug(f"Request ID: {getattr(ctx, 'request_id', 'No request_id')}")
            logger.debug(f"All Context attrs: {vars(ctx)}")
            logger.debug("=====================================")

            # Generate session ID - use request_id as it's more reliable
            session_id = str(id(ctx.session))
            logger.debug(f"Using session_id: {session_id}")

            # Check if we have any stored data for this session
            if (
                not hasattr(server, "_session_store")
